# Copia este archivo a .env.local y completa los valores. No pongas credenciales aquí: este archivo se sube a git.

# App (Project Settings -> Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para la CLI (migraciones / generación de tipos). No se exponen al navegador.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=us-east-1
